{% comment %}
  Filter sidebar app block (CLAUDE.md §12.1, §10.2).

  Renders Shopify's native filters immediately so the page is usable before
  scfs.js boots; the script then upgrades the markup in place.
{% endcomment %}

{% render 'scfs-context' %}

<div
  class="scfs scfs-sidebar scfs-sidebar--{{ block.settings.position }} scfs-spacing--{{ block.settings.spacing }}"
  data-scfs-sidebar
  data-scfs-layout="{{ block.settings.layout }}"
  data-scfs-show-counts="{{ block.settings.show_counts }}"
  data-scfs-show-clear="{{ block.settings.show_clear }}"
  data-scfs-mobile-drawer="{{ block.settings.mobile_drawer }}"
  style="
    --scfs-accent: {{ block.settings.accent_color }};
    --scfs-radius: {{ block.settings.border_radius }}px;
    --scfs-swatch-size: {{ block.settings.swatch_size }}px;
  "
  {{ block.shopify_attributes }}
>
  {%- if block.settings.mobile_drawer -%}
    <button
      type="button"
      class="scfs-drawer-toggle"
      data-scfs-drawer-open
      aria-expanded="false"
      aria-controls="scfs-drawer-panel"
    >
      <span>{{ 'filters.open' | t }}</span>
      <span class="scfs-drawer-toggle__count" data-scfs-active-count hidden>0</span>
    </button>
  {%- endif -%}

  <div class="scfs-sidebar__panel" id="scfs-drawer-panel" data-scfs-panel>
    <div class="scfs-sidebar__header">
      {%- if block.settings.title != blank -%}
        <h2 class="scfs-sidebar__title">{{ block.settings.title }}</h2>
      {%- endif -%}

      <button
        type="button"
        class="scfs-drawer-close"
        data-scfs-drawer-close
        aria-label="{{ 'filters.close' | t }}"
        hidden
      >
        <span aria-hidden="true">&times;</span>
      </button>
    </div>

    {%- if block.settings.show_clear -%}
      <button type="button" class="scfs-clear-all" data-scfs-clear-all hidden>
        {{ 'filters.clear_all' | t }}
      </button>
    {%- endif -%}

    {%- comment -%}
      Server-rendered fallback. `data-scfs-facets` is the mount point the script
      replaces once configuration and counts have loaded.
    {%- endcomment -%}
    <div class="scfs-facets" data-scfs-facets>
      {%- if collection.filters.size > 0 -%}
        {% render 'scfs-native-filters',
          filters: collection.filters,
          show_counts: block.settings.show_counts
        %}
      {%- else -%}
        <div class="scfs-facets__placeholder" aria-hidden="true">
          {%- for i in (1..4) -%}
            <div class="scfs-skeleton scfs-skeleton--group"></div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- if block.settings.mobile_drawer -%}
      <div class="scfs-drawer__footer">
        <button type="button" class="scfs-apply" data-scfs-drawer-apply>
          {{ 'filters.apply' | t }}
        </button>
      </div>
    {%- endif -%}
  </div>

  <div class="scfs-drawer__scrim" data-scfs-drawer-scrim hidden></div>
</div>

{% schema %}
{
  "name": "Product filters",
  "target": "section",
  "stylesheet": "scfs.css",
  "javascript": "scfs.js",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Filter layout",
      "options": [
        { "value": "sidebar", "label": "Sidebar" },
        { "value": "horizontal", "label": "Horizontal" },
        { "value": "dropdown", "label": "Dropdowns" },
        { "value": "accordion", "label": "Accordion" }
      ],
      "default": "sidebar"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Sidebar position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Spacing",
      "options": [
        { "value": "compact", "label": "Compact" },
        { "value": "base", "label": "Default" },
        { "value": "loose", "label": "Loose" }
      ],
      "default": "base"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Filters"
    },
    {
      "type": "checkbox",
      "id": "show_counts",
      "label": "Show product counts",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_clear",
      "label": "Show clear all button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "mobile_drawer",
      "label": "Use a drawer on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "swatch_size",
      "label": "Swatch size",
      "min": 16,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 28
    }
  ]
}
{% endschema %}
