{% comment %}
  Product grid for Engine App (CLAUDE.md §10.1, §13, §14).

  In Engine Native the theme's own collection section renders the products and
  this block is unnecessary. It exists for search pages and for filters Shopify
  cannot express natively.
{% endcomment %}

{% render 'scfs-context' %}

<div
  class="scfs scfs-results"
  data-scfs-results
  data-scfs-columns="{{ block.settings.columns }}"
  data-scfs-columns-mobile="{{ block.settings.columns_mobile }}"
  data-scfs-pagination="{{ block.settings.pagination }}"
  data-scfs-show-vendor="{{ block.settings.show_vendor }}"
  data-scfs-show-rating="{{ block.settings.show_rating }}"
  data-scfs-show-swatches="{{ block.settings.show_swatches }}"
  data-scfs-show-second-image="{{ block.settings.show_second_image }}"
  data-scfs-image-ratio="{{ block.settings.image_ratio }}"
  style="--scfs-radius: {{ block.settings.border_radius }}px;"
  {{ block.shopify_attributes }}
>
  <div class="scfs-results__grid" data-scfs-grid aria-busy="false">
    {%- comment -%}
      Skeletons keep the grid's height stable during the first fetch so the
      block contributes no layout shift (CLAUDE.md §17).
    {%- endcomment -%}
    {%- for i in (1..8) -%}
      <div class="scfs-card scfs-card--skeleton" aria-hidden="true">
        <div class="scfs-skeleton scfs-skeleton--image"></div>
        <div class="scfs-skeleton scfs-skeleton--line"></div>
        <div class="scfs-skeleton scfs-skeleton--line scfs-skeleton--short"></div>
      </div>
    {%- endfor -%}
  </div>

  <div class="scfs-results__empty" data-scfs-empty hidden>
    <p>{{ 'products.empty' | t }}</p>
    <button type="button" class="scfs-clear-all" data-scfs-clear-all>
      {{ 'products.empty_action' | t }}
    </button>
  </div>

  <div class="scfs-results__error" data-scfs-error role="alert" hidden>
    <p>{{ 'products.error' | t }}</p>
  </div>

  <nav class="scfs-pagination" data-scfs-pagination aria-label="Pagination" hidden></nav>
</div>

{% schema %}
{
  "name": "Product results",
  "target": "section",
  "stylesheet": "scfs.css",
  "javascript": "scfs.js",
  "settings": [
    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "pagination",
      "label": "Pagination style",
      "options": [
        { "value": "numbered", "label": "Numbered pages" },
        { "value": "load_more", "label": "Load more button" }
      ],
      "default": "numbered"
    },
    {
      "type": "header",
      "content": "Product card"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "label": "Show colour swatches",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_second_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 6
    }
  ]
}
{% endschema %}
