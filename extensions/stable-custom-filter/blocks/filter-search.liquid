{% comment %}
  Combined search + filters block (CLAUDE.md §12.1).

  A convenience wrapper for merchants who want one block instead of arranging
  the search and sidebar blocks separately. It reuses the same markup contracts,
  so the runtime treats it identically.
{% endcomment %}

{% render 'scfs-context' %}

<div
  class="scfs scfs-combined scfs-spacing--{{ block.settings.spacing }}"
  data-scfs-combined
  style="
    --scfs-accent: {{ block.settings.accent_color }};
    --scfs-radius: {{ block.settings.border_radius }}px;
  "
  {{ block.shopify_attributes }}
>
  {%- if block.settings.show_search -%}
    <div
      class="scfs-search scfs-search--inline"
      data-scfs-search
      data-scfs-min-chars="{{ block.settings.min_chars }}"
      data-scfs-debounce="250"
      data-scfs-predictive="true"
      data-scfs-filter-results="true"
    >
      <form
        class="scfs-search__form"
        action="{{ routes.search_url }}"
        method="get"
        role="search"
        data-scfs-search-form
      >
        <input type="hidden" name="type" value="product">
        <label class="scfs-visually-hidden" for="scfs-combined-search">
          {{ block.settings.placeholder }}
        </label>
        <div class="scfs-search__field">
          <input
            id="scfs-combined-search"
            class="scfs-search__input"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ block.settings.placeholder }}"
            autocomplete="off"
            role="combobox"
            aria-expanded="false"
            aria-controls="scfs-combined-results"
            aria-autocomplete="list"
            data-scfs-search-input
          >
          <button type="submit" class="scfs-search__submit">
            {{ 'search.submit' | t }}
          </button>
        </div>
        <div
          id="scfs-combined-results"
          class="scfs-search__results"
          data-scfs-search-results
          role="listbox"
          aria-label="{{ 'search.suggestions' | t }}"
          hidden
        ></div>
      </form>
    </div>
  {%- endif -%}

  <div
    class="scfs-sidebar scfs-sidebar--{{ block.settings.position }}"
    data-scfs-sidebar
    data-scfs-layout="{{ block.settings.layout }}"
    data-scfs-show-counts="{{ block.settings.show_counts }}"
    data-scfs-show-clear="true"
    data-scfs-mobile-drawer="{{ block.settings.mobile_drawer }}"
  >
    {%- if block.settings.mobile_drawer -%}
      <button
        type="button"
        class="scfs-drawer-toggle"
        data-scfs-drawer-open
        aria-expanded="false"
        aria-controls="scfs-combined-panel"
      >
        <span>{{ 'filters.open' | t }}</span>
        <span class="scfs-drawer-toggle__count" data-scfs-active-count hidden>0</span>
      </button>
    {%- endif -%}

    <div class="scfs-sidebar__panel" id="scfs-combined-panel" data-scfs-panel>
      <div class="scfs-sidebar__header">
        {%- if block.settings.title != blank -%}
          <h2 class="scfs-sidebar__title">{{ block.settings.title }}</h2>
        {%- endif -%}
        <button
          type="button"
          class="scfs-drawer-close"
          data-scfs-drawer-close
          aria-label="{{ 'filters.close' | t }}"
          hidden
        >
          <span aria-hidden="true">&times;</span>
        </button>
      </div>

      <button type="button" class="scfs-clear-all" data-scfs-clear-all hidden>
        {{ 'filters.clear_all' | t }}
      </button>

      <div class="scfs-facets" data-scfs-facets>
        {%- if collection.filters.size > 0 -%}
          {% render 'scfs-native-filters',
            filters: collection.filters,
            show_counts: block.settings.show_counts
          %}
        {%- endif -%}
      </div>

      {%- if block.settings.mobile_drawer -%}
        <div class="scfs-drawer__footer">
          <button type="button" class="scfs-apply" data-scfs-drawer-apply>
            {{ 'filters.apply' | t }}
          </button>
        </div>
      {%- endif -%}
    </div>

    <div class="scfs-drawer__scrim" data-scfs-drawer-scrim hidden></div>
  </div>
</div>

{% schema %}
{
  "name": "Filters + search",
  "target": "section",
  "stylesheet": "scfs.css",
  "javascript": "scfs.js",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search field",
      "default": true
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Search placeholder",
      "default": "Search products"
    },
    {
      "type": "range",
      "id": "min_chars",
      "label": "Minimum characters",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 2
    },
    {
      "type": "text",
      "id": "title",
      "label": "Filters heading",
      "default": "Filters"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Filter layout",
      "options": [
        { "value": "sidebar", "label": "Sidebar" },
        { "value": "horizontal", "label": "Horizontal" },
        { "value": "accordion", "label": "Accordion" }
      ],
      "default": "sidebar"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Sidebar position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Spacing",
      "options": [
        { "value": "compact", "label": "Compact" },
        { "value": "base", "label": "Default" },
        { "value": "loose", "label": "Loose" }
      ],
      "default": "base"
    },
    {
      "type": "checkbox",
      "id": "show_counts",
      "label": "Show product counts",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "mobile_drawer",
      "label": "Use a drawer on mobile",
      "default": true
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 6
    }
  ]
}
{% endschema %}
