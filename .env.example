# Copy to `.env` for local development.
# The Shopify CLI injects SHOPIFY_API_KEY / SHOPIFY_API_SECRET / SHOPIFY_APP_URL
# during `shopify app dev`, so you normally only need DATABASE_URL locally.

# --- Database -------------------------------------------------------------
# Local development (SQLite):
DATABASE_URL="file:dev.sqlite"
# Production (PostgreSQL) — also change `provider` in prisma/schema.prisma:
# DATABASE_URL="postgresql://user:password@host:5432/scfs?schema=public"

# --- Shopify --------------------------------------------------------------
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SHOPIFY_APP_URL=https://your-tunnel.trycloudflare.com
# SCOPES=read_products,read_inventory,unauthenticated_read_product_listings,unauthenticated_read_product_tags,unauthenticated_read_collection_listings,unauthenticated_read_product_inventory
# SHOP_CUSTOM_DOMAIN=

# --- App ------------------------------------------------------------------
# Salt used to hash storefront session identifiers before they are persisted.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANALYTICS_SESSION_SALT="change-me-in-production"

# Create test (non-charging) billing subscriptions on development stores.
SHOPIFY_BILLING_TEST="1"
